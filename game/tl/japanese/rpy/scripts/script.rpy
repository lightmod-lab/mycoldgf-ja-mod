    # Staff_s "早知道就不搞这个了……哎……"
    Staff_s "はじめからやらなければよかった……はあ……"

# game/rpy/scripts/script.rpy:3312
translate japanese start_a7781920:

    # Anran_s "……有点可怜。"
    Anran_s "……ちょっと可哀想。"

# game/rpy/scripts/script.rpy:3313
translate japanese start_72eb2f44:

    # Luzheng_s "呃……"
    Luzheng_s "え……"

# game/rpy/scripts/script.rpy:3314
translate japanese start_55d7f445:

    # kongbai_s "我出神地看看安冉手里的道具枪，又看看气球，最后凑到STAFF面前小声地说。"
    kongbai_s "俺は我を忘れて安冉の手にした小道具の銃と風船を見比べ、最後にスタッフの前へ寄って小声で尋ねた。"

