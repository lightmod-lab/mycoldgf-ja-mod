translate japanese start_506d0056:

    # Luzheng "没关系，coser的话拍写真明信片就行了。"
    Luzheng "気にしなくていい。コスプレをする人なら、お写真のポストカードで十分だから。"

# game/rpy/scripts/script.rpy:3282
translate japanese start_fbd6b9d7:

    # Anran "写、写真吗……"
    Anran "お、お写真って……"

# game/rpy/scripts/script.rpy:3283
translate japanese start_3017a831_15:

    # Anran "……"
    Anran "……"

# game/rpy/scripts/script.rpy:3284
translate japanese start_f193657c:

    # "她咬了咬嘴唇，脸上微微泛红。"
    "彼女は唇を噛み、顔にわずかに赤みが差した。"

# game/rpy/scripts/script.rpy:3285
translate japanese start_227bba29:

    # Anran "还、还是算了吧……"
    Anran "や、やっぱりやめておく……"

# game/rpy/scripts/script.rpy:3286
translate japanese start_ed33c45c_6:

    # Luzheng "嗯？"
    Luzheng "ん？"

# game/rpy/scripts/script.rpy:3287
translate japanese start_a34351aa:

    # "我一瞬间并不知道她为什么脸红，直到我余光看到了有个摊位在卖封面十分“火爆”的同人写真，才恍然大悟她对写真一词的误会。"
    "俺には一瞬、なぜ顔を赤らめたのか見当がつかなかった。視界の端に、表紙がかなり過激な同人写真集を売るブースが目に入ったとき、ようやく彼女は「写真」という言葉を勘違いしていると分かった。"

# game/rpy/scripts/script.rpy:3288
translate japanese start_4cf06ec6:

    # Luzheng "我说的不是那种写真啦！"
    Luzheng "俺が言うのは、そんな写真集のことじゃないから！"

# game/rpy/scripts/script.rpy:3290
translate japanese start_40a4e23c:

    # Anran "不是吗！"
    Anran "違うの！？"

# game/rpy/scripts/script.rpy:3291
translate japanese start_ca041aac:

    # Luzheng "肯定不是啊！"
    Luzheng "絶対違う！"

# game/rpy/scripts/script.rpy:3292
translate japanese start_7edcb03d:

    # Anran "……好、好吧。"
    Anran "……わ、わかった。"

# game/rpy/scripts/script.rpy:3293
translate japanese start_bf3858ca:

    # Luzheng "……说起来，有什么感兴趣的摊位吗？"
    Luzheng "……そういや、気になるブースはある？"

# game/rpy/scripts/script.rpy:3294
translate japanese start_048ca194:

    # "我们俩并肩走在专区的走道上，在拥挤的人潮中很小心地不让彼此消失在自己的视野里。"
    "俺たちは並んで専門エリアの通路を歩き、混み合う人波の中で、互いが視界から消えないように細心の注意を払っていた。"

# game/rpy/scripts/script.rpy:3296
translate japanese start_35ab816a:

    # Anran "要说的话，那个吧？"
    Anran "言うなら、あれかな？"

# game/rpy/scripts/script.rpy:3298
translate japanese start_0c28af7c:

    # Luzheng "那个是……"
    Luzheng "あれは……"

# game/rpy/scripts/script.rpy:3300
translate japanese start_713c8071:

    # kongbai_s "顺着她的目光，我看到了一家疑似打气球的摊位。"
    kongbai_s "彼女の視線の先に、風船撃ちのブースらしきものがあった。"

# game/rpy/scripts/script.rpy:3301
translate japanese start_f2b26b26:

    # kongbai_s "之所以说是疑似，是因为摊位前并没有人在举枪打气球，只有一位工作人员一脸倒霉样地坐在桌子后面。"
    kongbai_s "「らしき」と言うのは、ブースの前で誰も銃を構えて風船を撃っておらず、テーブルの奥には浮かない顔をしたスタッフが一人座っているだけだからだ。"

# game/rpy/scripts/script.rpy:3302
translate japanese start_b7c2c97b:

    # kongbai_s "——看起来怪怪的。"
    kongbai_s "——妙な感じがする。"

# game/rpy/scripts/script.rpy:3303
translate japanese start_4c5b7ea5:

    # Luzheng_s "咳咳，那个……"
    Luzheng_s "けほん、あの……"

# game/rpy/scripts/script.rpy:3304
translate japanese start_2119a33e:

    # kongbai_s "我跟安冉一起站在摊位前，那个STAFF头也不抬地甩了甩手。"
    kongbai_s "俺と安冉はブースの前に並んで立った。スタッフは顔も上げずに手を振った。"

# game/rpy/scripts/script.rpy:3305
translate japanese start_7b488085:

    # Staff_s "打不了，没枪。"
    Staff_s "できないよ。銃がないから。"

# game/rpy/scripts/script.rpy:3306
translate japanese start_4f411555:

    # Luzheng_s "……哈？"
    Luzheng_s "……は？"

# game/rpy/scripts/script.rpy:3307
translate japanese start_0cac3adf:

    # nvl clear
    # kongbai_s "难怪看起来怪怪的，一家疑似打气球的摊位前居然都没有放气枪。"
    nvl clear
    kongbai_s "なるほど、妙なわけだ。風船撃ちのブースのはずなのに、エアガンが一台も置いてない。"

# game/rpy/scripts/script.rpy:3309
translate japanese start_1591450d:

    # Staff_s "枪被安检的没收了。"
    Staff_s "銃は、保安検査で没収されたんだ。"

# game/rpy/scripts/script.rpy:3310
